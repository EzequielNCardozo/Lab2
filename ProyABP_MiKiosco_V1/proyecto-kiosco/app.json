{
  "expo": {
    "name": "Kiosco",
    "slug": "kiosco-movil",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kioscomovil",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F2"
      }
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "La cámara se usa para leer el código de barras de los productos."
        }
      ],
      "expo-sharing"
    ]
  }
}
